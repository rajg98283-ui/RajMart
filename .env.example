# ====================================================
# RAJ MART - Environment Variables Template
# Copy this file to .env for local overrides (never commit .env)
# ====================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (Used when SPRING_PROFILES_ACTIVE=prod)
DB_URL=jdbc:mysql://localhost:3306/rajmart_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_secure_password

# AI Chatbot Configuration
# Set to 'gemini' for Google Gemini API or 'mock' for local offline domain FAQ
AI_CHATBOT_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
